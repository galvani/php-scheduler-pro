{
    "name": "galvani/php-scheduler-pro",
    "description": "Swappable PHP scheduler: one task model and our own Redis mutex over Laravel's scheduler or crunz",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "ext-redis": "*",
        "dragonmantank/cron-expression": "^3.4",
        "psr/log": "^3.0",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "require-dev": {
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "crunzphp/crunz": "^3.7",
        "symfony/lock": "^7.4 || ^8.0",
        "symfony/framework-bundle": "^7.4 || ^8.0",
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^13.0",
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "suggest": {
        "ext-pdo": "Needed by Scheduling\\Task\\PdoTaskRepository",
        "illuminate/console": "Needed by Scheduling\\Bridge\\Laravel",
        "crunzphp/crunz": "Needed by Scheduling\\Bridge\\Crunz",
        "symfony/lock": "Needed by Scheduling\\Bridge\\Crunz"
    },
    "conflict": {
        "illuminate/console": "<12.0",
        "crunzphp/crunz": "<3.7",
        "symfony/lock": "<7.4"
    },
    "autoload": {
        "psr-4": {
            "Scheduling\\": "src/"
        }
    },
    "scripts": {
        "cs-fix": "XDEBUG_MODE=off vendor/bin/php-cs-fixer fix",
        "phpstan": "XDEBUG_MODE=off vendor/bin/phpstan analyse --memory-limit 3G",
        "phpmd": "XDEBUG_MODE=off ./vendor/bin/phpmd src ansi phpmd.xml",
        "cs-check": "XDEBUG_MODE=off vendor/bin/php-cs-fixer fix --dry-run --diff",
        "post-install-cmd": "git config core.hooksPath .githooks",
        "post-update-cmd": "git config core.hooksPath .githooks",
        "test": "XDEBUG_MODE=off vendor/bin/phpunit"
    },
    "autoload-dev": {
        "psr-4": {
            "Scheduling\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Scheduling\\Bridge\\Laravel\\SchedulingServiceProvider"
            ]
        }
    }
}
