{
    "name": "jan/scheduling",
    "type": "library",
    "require": {
        "php": ">=8.5",
        "dragonmantank/cron-expression": "^3.4"
    },
    "require-dev": {
        "illuminate/console": "^12.0",
        "illuminate/support": "^12.0",
        "crunzphp/crunz": "^3.7",
        "symfony/lock": "^7.0",
        "friendsofphp/php-cs-fixer": "^3.89",
        "phpmd/phpmd": "^2.15",
        "phpstan/phpstan": "^2.1"
    },
    "suggest": {
        "ext-redis": "Needed by Scheduling\\Lock\\RedisMutex",
        "illuminate/console": "Needed by Scheduling\\Bridge\\Laravel",
        "crunzphp/crunz": "Needed by Scheduling\\Bridge\\Crunz",
        "symfony/lock": "Needed by Scheduling\\Bridge\\Crunz"
    },
    "conflict": {
        "illuminate/console": "<12.0",
        "crunzphp/crunz": "<3.7",
        "symfony/lock": "<7.0"
    },
    "autoload": {
        "psr-4": {
            "Scheduling\\": "src/"
        }
    },
    "scripts": {
        "cs-fix": "XDEBUG_MODE=off vendor/bin/php-cs-fixer fix",
        "phpstan": "XDEBUG_MODE=off vendor/bin/phpstan analyse --memory-limit 3G",
        "phpmd": "XDEBUG_MODE=off ./vendor/bin/phpmd src ansi phpmd.xml",
        "cs-check": "XDEBUG_MODE=off vendor/bin/php-cs-fixer fix --dry-run --diff",
        "post-install-cmd": "git config core.hooksPath .githooks",
        "post-update-cmd": "git config core.hooksPath .githooks"
    }
}
