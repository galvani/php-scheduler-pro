{
    "name": "jan/scheduling-demo-symfony",
    "type": "project",
    "description": "Symfony 8 app running jan/scheduling on the crunz engine",
    "require": {
        "php": ">=8.5",
        "ext-redis": "*",
        "crunzphp/crunz": "^3.7",
        "jan/scheduling": "*@dev",
        "symfony/console": "^8.0",
        "symfony/dotenv": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/runtime": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../..",
            "options": {"symlink": true}
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
